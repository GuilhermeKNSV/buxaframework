              <label class="buxa-rule-field"><span>COLOR STYLE</span><select data-item-dice-tooltip-style><option value="neutral" {{#if tooltipNeutral}}selected{{/if}}>Neutral</option><option value="item" {{#if tooltipItem}}selected{{/if}}>Item rarity</option><option value="rarity" {{#if tooltipRarity}}selected{{/if}}>Choose rarity</option><option value="custom" {{#if tooltipCustom}}selected{{/if}}>Custom color</option></select></label>
