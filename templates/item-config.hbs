          <label data-item-decoration-text-wrap><span>TEXT / SYMBOL</span><input data-item-decoration-text type="text" value="{{text}}"></label>
          <label data-item-decoration-count-wrap><span>COUNT</span><input data-item-decoration-count type="number" min="1" max="12" step="1" value="{{count}}"></label>
          <label><span>COLOR</span><select data-item-decoration-style><option value="item" {{#if styleItem}}selected{{/if}}>ITEM RARITY</option><option value="neutral" {{#if styleNeutral}}selected{{/if}}>NEUTRAL</option><option value="rarity" {{#if styleRarity}}selected{{/if}}>CHOOSE RARITY</option><option value="custom" {{#if styleCustom}}selected{{/if}}>CUSTOM COLOR</option></select></label>
          <label data-item-decoration-rarity-wrap><span>RARITY</span><select data-item-decoration-rarity>{{#each rarityOptions}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
          <label data-item-decoration-color-wrap><span>CUSTOM</span><input data-item-decoration-color type="color" value="{{color}}"></label>
          <button type="button" class="buxa-item-increase-remove" data-item-remove-decoration title="Remove decoration"><i class="fa-solid fa-xmark"></i></button>
        </article>
      {{/each}}
    </div>
    <template data-item-dice-template><article class="buxa-item-dice-row buxa-rule-card" data-item-dice-row data-dice-id="">
        <header class="buxa-rule-card-header">
          <span class="buxa-rule-card-icon"><i class="fa-solid fa-dice-d20"></i></span>
          <span class="buxa-rule-card-heading"><strong data-buxa-rule-title>Dice roll</strong><small data-buxa-rule-summary>1d20 · Normal</small></span>
          <button type="button" class="buxa-rule-card-collapse" data-buxa-rule-collapse title="Expand or collapse roll" aria-expanded="true"><i class="fa-solid fa-chevron-up"></i></button>
          <button type="button" class="buxa-item-increase-remove" data-item-remove-dice title="Remove dice" aria-label="Remove dice"><i class="fa-solid fa-trash-can"></i></button>
        </header>
        <div class="buxa-rule-card-body" data-buxa-rule-body>
          <div class="buxa-rule-section-heading"><strong>Roll formula</strong><small>Pick one dice source. Flat bonus and modifiers apply to either.</small></div>
          <div class="buxa-dice-source-select" role="group" aria-label="Choose dice source">
            <button type="button" data-item-dice-source-option="fixed" aria-pressed="true"><i class="fa-solid fa-dice"></i> Fixed dice</button>
            <button type="button" data-item-dice-source-option="attribute" aria-pressed="false"><i class="fa-solid fa-chart-simple"></i> Attribute dice</button>
            <input type="checkbox" data-item-dice-attribute-enabled class="buxa-dice-source-value" tabindex="-1" aria-hidden="true">
          </div>
          <div class="buxa-item-dice-primary">
            <label class="buxa-rule-field buxa-rule-roll-label"><span>ROLL NAME</span><input data-item-dice-label type="text" value="Damage" placeholder="Damage"></label>
            <label class="buxa-rule-field buxa-rule-die" data-item-dice-fixed-wrap><span>FIXED DICE <em>quantity × sides</em></span><div class="buxa-dice-pair"><input data-item-dice-count type="number" min="0" step="1" value="1" title="Number of dice" aria-label="Number of dice"><b>d</b><input data-item-dice-faces type="number" min="2" step="1" value="20" title="Sides per die" aria-label="Sides per die"></div></label>
            <label class="buxa-rule-field buxa-rule-flat"><span>FLAT BONUS</span><input data-item-dice-flat type="number" step="0.01" value="0"></label>
            <label class="buxa-rule-field buxa-rule-mode"><span>ROLL MODE</span><select data-item-dice-roll-mode><option value="normal" selected>Normal</option><option value="advantage" >Advantage</option><option value="disadvantage" >Disadvantage</option></select></label>
          </div>
          <div class="buxa-rule-section-heading"><strong>Attribute source &amp; modifier</strong><small>Attribute dice replace fixed dice; modifiers remain optional.</small></div>
          <div class="buxa-item-dice-sources">
            <section class="buxa-rule-source-card buxa-rule-source-attribute">
              <strong class="buxa-rule-source-title">ATTRIBUTE DICE</strong>
              <div class="buxa-item-dice-attribute-fields" data-item-dice-attribute-wrap>
                <label class="buxa-rule-field"><span>ATTRIBUTE</span><select data-item-dice-attribute-id data-buxa-search-picker="Find an attribute">{{#each diceAttributeOptions}}<option value="{{id}}">{{label}}</option>{{/each}}</select></label>
                <label class="buxa-rule-field"><span>DIE SIDES</span><div class="buxa-dice-single"><b>d</b><input data-item-dice-attribute-faces type="number" min="2" step="1" value="20"></div></label>
              </div>
            </section>
            <section class="buxa-rule-source-card buxa-rule-source-modifier">
              <label class="buxa-rule-field"><span>ADD MODIFIER</span><select data-item-dice-modifier data-buxa-search-picker="Search modifiers">{{#each diceModifierOptions}}<option value="{{value}}">{{group}} · {{label}}</option>{{/each}}</select></label>
              <small class="buxa-rule-source-hint">Uses the selected attribute or proficiency modifier.</small>
            </section>
          </div>
          <div class="buxa-item-dice-options">
            <span>DISPLAY &amp; ACTIONS</span>
            <label class="buxa-rule-switch"><input data-item-dice-show-range type="checkbox" ><span>Show min–max range</span></label>
            <label class="buxa-rule-switch"><input data-item-dice-chat-roll type="checkbox" checked><span>Enable chat roll</span></label>
          </div>
          <details class="buxa-discovery-options"><summary><i class="fa-solid fa-eye"></i> Discovery &amp; reveal <small>Who sees this bonus and what happens on unlock</small></summary>
            <div class="buxa-discovery-fields">
              <label class="buxa-rule-field"><span>STATE</span><select data-item-entry-visibility><option value="revealed" selected>Revealed (active)</option><option value="locked" >Locked (inactive)</option><option value="hidden" >Hidden (???)</option><option value="dmOnly" >DM only</option></select></label>
              <label class="buxa-rule-field"><span>RARITY AFTER REVEAL</span><select data-item-reveal-rarity><option value="">Keep existing rarity</option>{{#each tooltipRarities}}<option value="{{id}}">{{label}}</option>{{/each}}</select></label>
              <label class="buxa-rule-field"><span>REVEALED DISPLAY LABEL</span><input data-item-reveal-label value="" placeholder="Keep existing label"></label>
              <label class="buxa-rule-field"><span>ICON ON REVEAL</span><input data-item-reveal-icon value="" placeholder="Keep existing icon (optional)"></label>
              <label class="buxa-rule-field"><span>REVEALED COLOR</span><select data-item-reveal-style><option value="keep" selected>Keep current</option><option value="neutral" >Neutral</option><option value="item" >Item rarity</option><option value="rarity" >Choose rarity</option><option value="custom" >Custom</option></select></label>
              <label class="buxa-rule-field"><span>CUSTOM COLOR</span><input data-item-reveal-color type="color" value="#b8c3d2"></label>
              <label class="buxa-rule-field"><span>COLOR RARITY</span><select data-item-reveal-color-rarity><option value="">Default</option>{{#each tooltipRarities}}<option value="{{id}}">{{label}}</option>{{/each}}</select></label>
            </div>
          </details>
          <details class="buxa-rule-appearance" data-buxa-appearance>
          <summary><span class="buxa-rule-appearance-title"><i class="fa-solid fa-palette"></i><strong>Item display</strong><small>Optional tooltip appearance and icon</small></span><i class="fa-solid fa-chevron-down buxa-rule-appearance-chevron"></i></summary>
          <div class="buxa-rule-appearance-body">
            <div class="buxa-item-increase-tooltip">
              <label class="buxa-item-increase-show buxa-rule-switch"><input data-item-dice-tooltip-enabled type="checkbox" checked><span>SHOW ON ITEM</span></label>
              <label class="buxa-rule-field buxa-rule-label-long"><span>DISPLAY LABEL</span><input data-item-dice-tooltip-label type="text" value="" placeholder="Same as roll name"></label>
              <label class="buxa-rule-field"><span>COLOR STYLE</span><select data-item-dice-tooltip-style><option value="neutral" selected>Neutral</option><option value="item">Item rarity</option><option value="rarity">Choose rarity</option><option value="custom">Custom color</option></select></label>
              <label class="buxa-rule-field" data-item-dice-tooltip-rarity-wrap><span>RARITY</span><select data-item-dice-tooltip-rarity>{{#each tooltipRarities}}<option value="{{id}}">{{label}}</option>{{/each}}</select></label>
              <label class="buxa-rule-field buxa-rule-color" data-item-dice-tooltip-color-wrap><span>CUSTOM COLOR</span><input data-item-dice-tooltip-color type="color" value="#b8c3d2"></label>
              <label class="buxa-item-tooltip-icon-field buxa-rule-field"><span>ICON (OPTIONAL)</span><div><input data-item-tooltip-icon type="text" value="" placeholder="Choose an icon"><button type="button" data-item-tooltip-icon-browse title="Browse icons" aria-label="Browse icons"><i class="fa-solid fa-folder-open"></i></button></div></label>
            </div>
          </div>
        </details>
        </div>
      </article></template>
    <template data-item-description-template>
      <article class="buxa-description-part" data-item-description-part data-description-id="">
        <div class="buxa-description-part-fields">
          <label class="buxa-rule-field"><span>PUBLIC / INITIAL TEXT</span><textarea data-description-text rows="2" placeholder="This item belongs to"></textarea></label>
          <label class="buxa-rule-field"><span>TEXT AFTER REVEAL (OPTIONAL)</span><textarea data-description-reveal-text rows="2" placeholder="Loki"></textarea></label>
        </div>
        <div class="buxa-description-part-options">
          <label class="buxa-rule-field"><span>STATE</span><select data-description-visibility><option value="revealed">Revealed</option><option value="locked">Locked</option><option value="hidden">Hidden (???)</option><option value="dmOnly">DM only</option></select></label>
          <label class="buxa-rule-field"><span>JOIN TO PREVIOUS</span><select data-description-join><option value="space">Space</option><option value="none">Directly</option><option value="line">New line</option></select></label>
          <button type="button" class="buxa-discovery-remove" data-remove-description-part title="Remove field"><i class="fa-solid fa-trash-can"></i></button>
        </div>
      </article>
    </template>
    <template data-item-decoration-template>
      <article class="buxa-item-decoration-row" data-item-decoration-row data-decoration-id="">
        <label><span>TYPE</span><select data-item-decoration-type><option value="divider" selected>DIVIDER</option><option value="symbols">SYMBOLS</option><option value="text">TEXT</option><option value="spacer">SPACER</option></select></label>
        <label><span>POSITION</span><select data-item-decoration-placement><option value="beforeDice">BEFORE DICE</option><option value="between" selected>BETWEEN</option><option value="beforeDescription">BEFORE DESCRIPTION</option></select></label>
        <label data-item-decoration-text-wrap class="is-disabled"><span>TEXT / SYMBOL</span><input data-item-decoration-text type="text" value="" disabled></label>
        <label data-item-decoration-count-wrap class="is-disabled"><span>COUNT</span><input data-item-decoration-count type="number" min="1" max="12" step="1" value="3" disabled></label>
        <label><span>COLOR</span><select data-item-decoration-style><option value="item">ITEM RARITY</option><option value="neutral" selected>NEUTRAL</option><option value="rarity">CHOOSE RARITY</option><option value="custom">CUSTOM COLOR</option></select></label>
        <label data-item-decoration-rarity-wrap class="is-disabled"><span>RARITY</span><select data-item-decoration-rarity disabled>{{#each tooltipRarities}}<option value="{{id}}">{{label}}</option>{{/each}}</select></label>
        <label data-item-decoration-color-wrap class="is-disabled"><span>CUSTOM</span><input data-item-decoration-color type="color" value="#b8c3d2" disabled></label>
        <button type="button" class="buxa-item-increase-remove" data-item-remove-decoration><i class="fa-solid fa-xmark"></i></button>
      </article>
    </template>
  </div>
  <div class="buxa-item-config-stack buxa-item-size-settings" data-item-config-panel="size" {{#unless activeConfigTabs.size}}hidden{{/unless}}>
    <section class="buxa-item-config-section buxa-footprint-section">
      <header><div><i class="fa-solid fa-shapes"></i><strong>ITEM FOOTPRINT</strong></div></header>
      <div class="buxa-footprint-body">
        <div class="buxa-footprint-head">
          <span>Click cells to shape the item. Click artwork to select, drag to move, pull handles to resize or rotate.</span>
          <strong data-item-shape-dimensions>1 × 1</strong>
        </div>
        <div class="buxa-shape-editor-grid" data-item-shape-grid aria-label="Shape and artwork editor"></div>
        <div class="buxa-footprint-footer">
          <span data-item-shape-count>1 cell</span>
          <span class="buxa-shape-shortcut">SHIFT + drag rotation handle = 15° steps</span>
          <button type="button" data-item-shape-reset title="Reset shape and artwork"><i class="fa-solid fa-rotate-left"></i> Reset</button>
        </div>
      </div>
    </section>
  </div>
  <div class="buxa-item-config-stack buxa-control-config" data-item-config-panel="control" {{#unless activeConfigTabs.control}}hidden{{/unless}}>
    <section class="buxa-item-config-section">
      <header><div><i class="fa-solid fa-unlock-keyhole"></i><span><strong>DISCOVERY CONTROL</strong><small>Reveal or conceal powers instantly, without reopening their individual editors.</small></span></div></header>
      <div class="buxa-item-config-section-body">
        <p class="buxa-discovery-hint">These actions save immediately to the item. Save newly added or edited Increase, Dice and modular description fields first so they appear here.</p>
        <div class="buxa-control-entry-list">
          {{#each controlEntries}}
          <article class="buxa-control-entry buxa-control-{{visibility}}" data-item-control-entry data-kind="{{kind}}" data-entry-id="{{id}}">
            <div class="buxa-control-entry-info"><strong>{{title}}</strong><small>{{detail}}</small><span class="buxa-control-status" data-item-control-status aria-live="polite">{{visibilityLabel}}</span></div>
            <div class="buxa-control-entry-actions" role="group" aria-label="Discovery state for {{title}}">
              <button type="button" data-item-control-set data-visibility="revealed" class="{{#if isRevealed}}is-active{{/if}}" aria-pressed="{{isRevealed}}" title="Activate and reveal"><i class="fa-solid fa-lock-open"></i> Reveal</button>
              <button type="button" data-item-control-set data-visibility="locked" class="{{#if isLocked}}is-active{{/if}}" aria-pressed="{{isLocked}}" title="Visible, inactive"><i class="fa-solid fa-lock"></i> Lock</button>
              <button type="button" data-item-control-set data-visibility="hidden" class="{{#if isHidden}}is-active{{/if}}" aria-pressed="{{isHidden}}" title="Show ???"><i class="fa-solid fa-eye-slash"></i> Hidden</button>
              <button type="button" data-item-control-set data-visibility="dmOnly" class="{{#if isDmOnly}}is-active{{/if}}" aria-pressed="{{isDmOnly}}" title="Not visible on player item sheet"><i class="fa-solid fa-user-shield"></i> DM only</button>
            </div>
          </article>
          {{else}}
          <p class="buxa-control-empty">No saved Increase, Dice or modular description fields yet. Add them, save the item, then return to Control.</p>
          {{/each}}
        </div>
      </div>
    </section>
  </div>
</div>
