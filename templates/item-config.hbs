              <label class="buxa-rule-field"><span>ICON ON REVEAL</span><input data-item-reveal-icon value="{{reveal.icon}}" placeholder="Keep existing icon (optional)"></label>
              <label class="buxa-rule-field"><span>REVEALED COLOR</span><select data-item-reveal-style><option value="keep" {{#if revealStyleKeep}}selected{{/if}}>Keep current</option><option value="neutral" {{#if revealStyleNeutral}}selected{{/if}}>Neutral</option><option value="item" {{#if revealStyleItem}}selected{{/if}}>Item rarity</option><option value="rarity" {{#if revealStyleRarity}}selected{{/if}}>Choose rarity</option><option value="custom" {{#if revealStyleCustom}}selected{{/if}}>Custom</option></select></label>
              <label class="buxa-rule-field"><span>CUSTOM COLOR</span><input data-item-reveal-color type="color" value="{{reveal.color}}"></label>
              <label class="buxa-rule-field"><span>COLOR RARITY</span><select data-item-reveal-color-rarity><option value="">Default</option>{{#each revealColorRarities}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
            </div>
          </details>
          <details class="buxa-rule-appearance" data-buxa-appearance>
