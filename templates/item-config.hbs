    <div class="buxa-item-decoration-list" data-item-decoration-list>
      {{#each decorations}}
        <article class="buxa-item-decoration-row" data-item-decoration-row data-decoration-id="{{id}}">
          <label><span>TYPE</span><select data-item-decoration-type><option value="divider" {{#if isDivider}}selected{{/if}}>DIVIDER</option><option value="symbols" {{#if isSymbols}}selected{{/if}}>SYMBOLS</option><option value="text" {{#if isText}}selected{{/if}}>TEXT</option><option value="spacer" {{#if isSpacer}}selected{{/if}}>SPACER</option></select></label>
