<section class="buxa-attribute-setter" style="--buxa-accent-local: {{accent}};">
  <header class="buxa-attribute-setter-head">
    <div class="buxa-attribute-setter-icon">#</div>
    <div>
      <strong>{{attribute.label}}</strong>
      <span>Add points to this attribute</span>
    </div>
  </header>

  <label class="buxa-attribute-setter-field">
    <span>POINTS TO ADD</span>
    <input type="number" min="1" step="1" name="value" placeholder="Enter amount" required autofocus>
  </label>

  <footer class="buxa-dialog-footer buxa-attribute-setter-footer">
    <button type="submit">
      <span aria-hidden="true">✓</span>
      <span>Apply</span>
    </button>
  </footer>
</section>
